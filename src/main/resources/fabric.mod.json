{
  "schemaVersion": 1,
  "id": "wildbound",
  "version": "${version}",
  "name": "WILDBOUND: Realms of Ascension",
  "description": "RPG de mundo abierto para Minecraft Fabric.",
  "authors": [
    "angeld03",
    "botellarapida"
  ],
  "contact": {
    "homepage": "https://github.com/angeld03/fabric-mod",
    "sources": "https://github.com/angeld03/fabric-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/wildbound/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.wildbound.Wildbound"
    ],
    "client": [
      "com.wildbound.client.WildboundClient"
    ]
  },
  "mixins": [
    "wildbound.mixins.json",
    {
      "config": "wildbound.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}